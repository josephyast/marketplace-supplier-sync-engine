# Copy to .env and fill in real values. Never commit .env.

BASE_PATH=/sync

# Supplier CSV catalog (semicolon-delimited)
SOURCE_URL=https://api.supplier-example.com/v1/catalog.csv

# Marketplace seller API
MARKETPLACE_API_URL=https://api.marketplace-example.com/v1

# Store A
MARKETPLACE_API_KEY=your-api-key
MARKETPLACE_CLIENT_ID=your-client-id

# Store B
MARKETPLACE_API_KEY2=your-api-key
MARKETPLACE_CLIENT_ID2=your-client-id

# SMTP email report
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SENDER_EMAIL=sender@example.com
SENDER_PASSWORD=your-app-password
RECEIVER_EMAIL=receiver@example.com
